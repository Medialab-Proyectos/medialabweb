    T7["generateAITrendRecommendations()"]
    T1 --> T3
    T2 --> T3
    T3 --> T4 --> T5 --> T6 --> T7
  end

  %% ===================== 5. SÍNTESIS =====================
  subgraph SYNTH["4 · SÍNTESIS Y PRIORIZACIÓN"]
    direction TB
    X1["crossChannelAnalyzer.ts<br/>opportunityScore = trends + GSC + aiTrend + UX +<br/>designAI + dev + youtube + social + reddit +<br/>intención comercial + gap AEO + gap competidor − dificultad"]
