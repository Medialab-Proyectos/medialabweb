    K3["npm run audit:evening<br/>reporte tarde/noche"]
    K4["npm run compare<br/>consolida mañana vs noche"]
    K5["npm run ai-trends<br/>solo tendencias IA"]
    K6["npm run generate-briefs<br/>briefs accionables"]
  end

  subgraph CFG["⚙️ CONFIGURACIÓN E INSUMOS (src/config.ts · zod)"]
    direction LR
    G1[".env<br/>SITE_URL · GSC · keys opcionales"]
    G2["data/strategic-keywords.json"]
    G3["data/competitors.json"]
    G4["data/ai-trend-categories.json"]
    G5["data/*.csv<br/>trends · ai-trends · ossinsight · social"]
    G6["credentials/service-account.json<br/>(Search Console)"]
  end

