  subgraph AITR["3b · AI TRENDS ANALYZER — pipeline interno"]
    direction LR
    T1["getGitHubAITrends()<br/>topics: ai-agents·llm·rag·mcp·generative-ui…"]
    T2["loadAITrendsFromCSV()<br/>fallback sin token"]
