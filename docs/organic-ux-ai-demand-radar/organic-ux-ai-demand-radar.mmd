  subgraph DEMAND["3 · DEMANDA, BÚSQUEDA Y TENDENCIAS"]
    direction TB
    D1["searchConsole.ts<br/>googleapis · 7 días · QuickWins/CTR bajo/casi top10"]
    D2["googleTrends.ts<br/>CSV (recom.) · crecimiento mayor a 20% = oportunidad"]
