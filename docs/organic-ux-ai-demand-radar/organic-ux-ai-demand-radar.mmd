  subgraph PAGE["2 · AUDITORÍA POR PÁGINA (por URL, con p-limit + REQUEST_DELAY_MS)"]
    direction TB
    A1["crawler.ts · auditPage()<br/>title/meta/H1 · schema · OG · CTAs · tipo de página"]
