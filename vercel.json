{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/experience-radar/run",
      "schedule": "0 11 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.medialab.design" }],
      "destination": "https://medialab.design/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "medialabingenieria.com" }],
      "destination": "https://medialab.design/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.medialabingenieria.com" }],
      "destination": "https://medialab.design/:path",
      "permanent": true
    }
  ]
}
